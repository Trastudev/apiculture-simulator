<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ApicultureSimulator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorPrimary">@color/login_primary_orange</item>
        <item name="colorPrimaryDark">#E07828</item>
    </style>

    <style name="ShapeAppearance.Apiculture.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThemeOverlay.Apiculture.SettingsMenu" parent="ThemeOverlay.Material3.Light">
        <item name="android:popupBackground">@drawable/bg_settings_popup</item>
        <item name="popupMenuBackground">@drawable/bg_settings_popup</item>
        <item name="android:textColor">@color/login_text_dark</item>
    </style>

    <style name="ShapeAppearance.Apiculture.Rounded16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
