<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_shop_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_colmena_prado" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_pending_hive_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/event_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Núcleo 1" />

        <TextView
            android:id="@+id/tv_pending_hive_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/event_ink_muted"
            android:textSize="12sp"
            tools:text="Viaja el 21 sep · sale de Olivar norte" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pending_hive_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="@string/market_contract_pending_cancel_hint"
        android:textAllCaps="false"
        android:textColor="@color/event_gold_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        app:rippleColor="@color/event_gold_stroke" />
</LinearLayout>
