<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_shop_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/iv_parcel_pick"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/market_contract_pick_section_land"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_apiario_otro" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_parcel_pick_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/event_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Prado del Xúquer" />

        <TextView
            android:id="@+id/tv_parcel_pick_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/event_ink_muted"
            android:textSize="12sp"
            tools:text="3 colmenas" />
    </LinearLayout>
</LinearLayout>
