<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/event_cream"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/event_gold_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/profile_edit_title"
                android:textColor="@color/event_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dash_avatar_ring"
                android:padding="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_profile_edit_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_edit_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_apicultor"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Apisim.Circle" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_pick_photo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_edit_change_photo"
                android:textAllCaps="false"
                android:textColor="@color/event_ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/profile_setup_player_name"
                android:textColor="@color/event_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_shop_card"
                android:hint="@string/profile_setup_player_name"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="40"
                android:minHeight="48dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:singleLine="true"
                android:textColor="@color/event_ink"
                android:textColorHint="@color/event_ink_muted"
                android:textSize="14sp"
                tools:text="Carlos" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_brand_emblem"
                android:textColor="@color/event_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_profile_brand"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/profile_brand_emblem" />

                <TextView
                    android:id="@+id/tv_profile_brand_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/profile_brand_hint"
                    android:textColor="@color/event_ink_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_brand_logo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/profile_brand_logo_pick"
                    android:textAllCaps="false"
                    android:textColor="@color/event_ink"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/event_gold_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_brand_logo_clear"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/profile_brand_logo_clear"
                    android:textAllCaps="false"
                    android:textColor="@color/event_ink"
                    android:visibility="gone"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/event_gold_stroke" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_profile_brand_emblems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_profile_brand_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/profile_language"
                android:textColor="@color/event_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_profile_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rb_lang_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_language_system"
                    android:textColor="@color/event_ink" />

                <RadioButton
                    android:id="@+id/rb_lang_es"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Español"
                    android:textColor="@color/event_ink" />

                <RadioButton
                    android:id="@+id/rb_lang_ca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Català"
                    android:textColor="@color/event_ink" />

                <RadioButton
                    android:id="@+id/rb_lang_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textColor="@color/event_ink" />

                <RadioButton
                    android:id="@+id/rb_lang_gl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Galego"
                    android:textColor="@color/event_ink" />

                <RadioButton
                    android:id="@+id/rb_lang_eu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Euskara"
                    android:textColor="@color/event_ink" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_lang_accept"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/profile_lang_accept"
                android:textAllCaps="false"
                android:textColor="@color/event_ink"
                android:textStyle="bold"
                app:backgroundTint="@color/event_gold"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_save"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:text="@string/profile_edit_save"
                android:textAllCaps="false"
                android:textColor="@color/event_ink"
                android:textStyle="bold"
                app:backgroundTint="@color/event_gold"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/hex_purchase_cancel"
                android:textAllCaps="false"
                android:textColor="@color/event_ink_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
