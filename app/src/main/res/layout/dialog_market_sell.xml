<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="@color/event_cream"
    app:cardCornerRadius="22dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/event_gold_stroke"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_event_global_body"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_event_kicker_pill"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/market_sell_kicker"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_sell_flora"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_lavanda" />

        <TextView
            android:id="@+id/tv_sell_flora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/event_ink"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Lavanda" />

        <TextView
            android:id="@+id/tv_sell_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/event_ink_muted"
            android:textSize="13sp"
            tools:text="14,20 B/kg · Stock 6,2 kg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/market_sell_amount_label"
            android:textColor="@color/event_ink_muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_sell_kg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dialog_field"
            android:gravity="center"
            android:hint="@string/market_sell_amount_hint"
            android:inputType="numberDecimal"
            android:textColor="@color/event_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seek_sell_kg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progressTint="@color/event_gold"
            android:thumbTint="@color/event_gold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sell_max"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/market_sell_max"
            android:textAllCaps="false"
            android:textColor="@color/event_gold_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sell_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/event_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Cobras 88,04" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/cd_stat_balance"
                android:src="@drawable/ic_beecoin" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sell_confirm"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="@string/market_sell_confirm"
            android:textAllCaps="false"
            android:textColor="@color/event_ink"
            android:textStyle="bold"
            app:backgroundTint="@color/event_gold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sell_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/hex_dialog_close"
            android:textAllCaps="false"
            android:textColor="@color/event_ink_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
