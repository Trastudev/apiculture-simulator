<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/dash_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp">

        <!-- Cabecera colmena -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_compracolmena"
                android:contentDescription="@string/dashboard_my_hives" />

            <TextView
                android:id="@+id/tv_hive_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="1"
                android:text="Colmena Alfa"
                android:textColor="@color/dash_text_card"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_hive_card_honey_warn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/hive_detail_honey_cap_warn_cd"
                    android:visibility="gone"
                    android:src="@drawable/ic_honey_cap_alert"
                    app:tint="@color/dash_warning" />

                <ImageView
                    android:id="@+id/iv_hive_card_swarm_warn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/hive_detail_swarm_icon_cd"
                    android:visibility="gone"
                    android:src="@drawable/ic_swarm_danger_alert"
                    app:tint="@null" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salud"
                android:textColor="@color/dash_muted"
            android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/pb_hive_health"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="90" />

            <TextView
                android:id="@+id/tv_hive_health"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textColor="@color/dash_muted"
            android:textSize="11sp" />
        </LinearLayout>

        <!-- Obreras adultas (contador) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_abeja"
                android:contentDescription="@string/cd_stat_bees" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/hive_card_obreras_label"
                android:textColor="@color/dash_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hive_bees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="25000"
                android:textColor="@color/dash_text_card"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Miel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_recolectar"
                android:contentDescription="@string/cd_stat_honey_harvested" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Miel"
                android:textColor="@color/dash_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hive_honey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="2.4 kg"
                android:textColor="@color/dash_text_card"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Flora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_hive_flora_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_deco_flower"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mil_flores" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Flora:"
                android:textColor="@color/dash_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hive_flora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Campo de romero"
                android:textColor="@color/dash_text_card"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Alzas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/hive_card_buy_super"
                android:src="@drawable/ic_compracolmena" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Alzas"
                android:textColor="@color/dash_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_hive_supers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0/2"
                android:textColor="@color/dash_text_card"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botones Detalle / Comprar alza -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hive_detail"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="@string/hive_card_detail"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hive_buy_super"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:text="@string/hive_card_buy_super"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

