<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/event_cream"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/event_gold_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_event_global_body"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_market_picker_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_event_kicker_pill"
                android:letterSpacing="0.08"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/market_sell_kicker"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/market_picker_title"
                android:textColor="@color/event_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/market_picker_hint"
                android:textColor="@color/event_ink_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_market_picker_origin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/event_ink_muted"
                android:textSize="12sp"
                tools:text="Desde: Sede de Iberia" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/market_picker_region_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:checkedButton="@id/btn_market_picker_iberia"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_market_picker_iberia"
                    style="@style/Widget.Apisim.MapRegionButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/market_picker_region_iberia"
                    app:backgroundTint="@color/map_region_btn_bg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_market_picker_madagascar"
                    style="@style/Widget.Apisim.MapRegionButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/market_picker_region_madagascar"
                    app:backgroundTint="@color/map_region_btn_bg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_market_picker_south_africa"
                    style="@style/Widget.Apisim.MapRegionButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/market_picker_region_south_africa"
                    app:backgroundTint="@color/map_region_btn_bg"
                    app:icon="@drawable/ic_lock_padlock"
                    app:iconGravity="textEnd"
                    app:iconPadding="4dp"
                    app:iconSize="15dp"
                    app:iconTint="@null" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tv_market_picker_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/market_picker_empty"
                android:textColor="@color/event_ink_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_market_picker"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_market_picker" />

            <LinearLayout
                android:id="@+id/ll_market_picker_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_market_picker_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/market_honey_page_prev"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/tv_market_picker_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:textColor="@color/event_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="1 / 3" />

                <ImageButton
                    android:id="@+id/btn_market_picker_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/market_honey_page_next"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_market_picker_close"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/market_picker_close"
                android:textAllCaps="false"
                android:textColor="@color/event_ink"
                android:textStyle="bold"
                app:backgroundTint="@color/event_gold"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.core.widget.NestedScrollView>
