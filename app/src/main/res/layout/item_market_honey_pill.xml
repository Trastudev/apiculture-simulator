<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/event_cream"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:contentPadding="12dp"
    app:strokeColor="@color/event_gold_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_pill_flora"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@drawable/ic_lavanda"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_pill_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/event_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Lavanda" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/market_price_spark_cd"
            android:textAllCaps="true"
            android:textColor="@color/event_ink_muted"
            android:textSize="9sp"
            android:textStyle="bold" />

        <com.apiculture.simulator.presentation.market.MarketPriceSparkView
            android:id="@+id/chart_price_7d"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_pill_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/event_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="14,20 B/kg" />

        <TextView
            android:id="@+id/tv_pill_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/event_gold_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="+17 % vs capital"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_pill_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/event_ink_muted"
            android:textSize="11sp"
            tools:text="Tu miel: 6,2 kg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sell"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/market_sell"
            android:textAllCaps="false"
            android:textColor="@color/event_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/event_gold"
            app:cornerRadius="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
