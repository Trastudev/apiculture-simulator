<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="@color/event_cream"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeColor="@color/event_gold_stroke"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_event_global_body"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_event_kicker_pill"
            android:letterSpacing="0.12"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="@string/crop_unlock_kicker"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/crop_unlock_title"
            android:textColor="@color/event_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/crop_unlock_subtitle"
            android:textColor="@color/event_ink_muted"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_shop_card"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_crop_unlock_jar"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@drawable/ic_naranjos" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_crop_unlock_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/event_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Campo de naranjos" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crop_unlock_next"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/crop_unlock_next"
            android:textAllCaps="false"
            android:textColor="@color/event_ink"
            android:textStyle="bold"
            app:backgroundTint="@color/event_gold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
