<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_trip_box"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_leg_from"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_almacen_miel" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right" />

        <ImageView
            android:id="@+id/iv_leg_to"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_fleet_port" />

        <TextView
            android:id="@+id/tv_leg_route"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/dash_muted"
            android:textSize="12sp"
            tools:text="Almacén → Puerto" />

        <TextView
            android:id="@+id/tv_leg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/dash_text_card"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="40 min" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hs_leg_honey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ll_leg_honey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
