<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/event_cream"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/event_gold_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_harvest_trips_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/harvest_trips_title"
                android:textColor="@color/event_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_harvest_trips_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/harvest_trips_subtitle"
                android:textColor="@color/event_ink_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/ll_harvest_trips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_shop_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tv_harvest_trips_skipped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/event_ink_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_harvest_trips_ok"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/harvest_trips_confirm"
                android:textAllCaps="false"
                android:textColor="@color/event_ink"
                android:textStyle="bold"
                app:backgroundTint="@color/event_gold"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_harvest_trips_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="4dp"
                android:text="@string/harvest_trips_cancel"
                android:textAllCaps="false"
                android:textColor="@color/event_ink_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
