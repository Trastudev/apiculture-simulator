<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_planting_flora"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_lavanda" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <TextView
        android:id="@+id/tv_planting_parcel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dash_text_card"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Terreno 123456" />

    <TextView
        android:id="@+id/tv_planting_flora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/dash_muted"
        android:textSize="13sp"
        tools:text="Lavanda" />

    <TextView
        android:id="@+id/tv_planting_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/login_text_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="18:42:05" />

    <ProgressBar
        android:id="@+id/bar_planting_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progress="400"
        android:progressTint="@color/dash_good" />
    </LinearLayout>
</LinearLayout>
