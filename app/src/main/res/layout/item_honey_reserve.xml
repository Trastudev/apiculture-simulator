<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <ImageView
        android:id="@+id/iv_reserve_flora"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cd_deco_honey"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_reserve_flora_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/event_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Milflores" />

        <TextView
            android:id="@+id/tv_reserve_flora_qty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/event_ink_muted"
            android:textSize="13sp"
            tools:text="12,4 kg" />
    </LinearLayout>
</LinearLayout>
