<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:paddingHorizontal="20dp"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/event_cream"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/event_gold_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_event_global_body"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/iv_local_banner"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/map_market_international_kicker"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_market_international"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_local_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_event_kicker_pill"
                android:letterSpacing="0.08"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Mercado local" />

            <TextView
                android:id="@+id/tv_local_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/event_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Vic" />

            <TextView
                android:id="@+id/tv_local_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/event_ink_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_local_demand_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/map_market_demand_label"
                android:textColor="@color/event_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_local_demand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/ll_demand_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_demand_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/market_honey_page_prev"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/tv_demand_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="@color/event_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="1 / 3" />

                <ImageButton
                    android:id="@+id/btn_demand_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/market_honey_page_next"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_local_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/map_market_empty_stock"
                android:textColor="@color/event_ink_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_local_pills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:id="@+id/ll_pills_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_pills_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/market_honey_page_prev"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    android:id="@+id/tv_pills_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="@color/event_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="1 / 2" />

                <ImageButton
                    android:id="@+id/btn_pills_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/market_honey_page_next"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_local_accept"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/hive_dialog_accept"
                android:textAllCaps="false"
                android:textColor="@color/event_ink"
                android:textStyle="bold"
                app:backgroundTint="@color/event_gold"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.core.widget.NestedScrollView>
