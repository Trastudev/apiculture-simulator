<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7EC8E3">

    <com.apiculture.simulator.presentation.hive.ApiaryYardView
        android:id="@+id/yard_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/apiary_yard_cd" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_yard_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_yard_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/apiary_yard_back"
                android:textAllCaps="false"
                android:textColor="@color/event_gold_dark"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_yard_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/event_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Olivar norte" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_yard_npc_face"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_npc_portrait_ring"
                android:contentDescription="@string/apiary_card_contract"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Apisim.Circle"
                app:strokeColor="@color/event_gold"
                app:strokeWidth="1.5dp"
                tools:src="@drawable/npc_face_00"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_yard_3d"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/apiary_3d_open"
                android:textAllCaps="false"
                android:textColor="@color/event_gold_dark"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/iv_yard_weather"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sol_prado" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_yard_maint_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dash_event_alert"
            android:drawableStart="@drawable/ic_maint_dot"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/apiary_yard_maint_banner"
            android:textColor="#B71C1C"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_yard_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="28dp"
        android:background="@drawable/bg_yard_header"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/apiary_yard_empty"
        android:textColor="@color/event_ink"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_yard_buy_hive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apiary_yard_buy_hive"
            android:textAllCaps="false" />
    </LinearLayout>
</FrameLayout>
