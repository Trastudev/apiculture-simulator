<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_workshop_back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/workshop_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_deco_honey_jar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workshop_name"
                    android:textColor="@color/event_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_workshop_where"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/event_ink_muted"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Junto al almacén Can Pep"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_workshop_3d"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/apiary_3d_open"
                android:textAllCaps="false"
                android:textColor="@color/event_gold_dark"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_workshop_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/event_gold_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Saldo: 45000,00 B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/workshop_subtitle"
            android:textColor="@color/event_ink_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pb_workshop_loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Sin obrador: elegir almacén -->
        <LinearLayout
            android:id="@+id/ll_workshop_build"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/WorkshopSection"
                android:text="@string/workshop_build_title" />

            <TextView
                android:id="@+id/tv_workshop_build_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/event_ink"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/ll_workshop_build_sites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Con obrador -->
        <LinearLayout
            android:id="@+id/ll_workshop_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/WorkshopSection"
                android:text="@string/workshop_batches" />

            <LinearLayout
                android:id="@+id/ll_workshop_batches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/WorkshopSection"
                android:text="@string/workshop_stock" />

            <LinearLayout
                android:id="@+id/ll_workshop_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/WorkshopSection"
                android:text="@string/workshop_wax" />

            <LinearLayout
                android:id="@+id/ll_workshop_wax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/WorkshopSection"
                android:text="@string/workshop_machines" />

            <LinearLayout
                android:id="@+id/ll_workshop_machines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
