<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_apiary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clickable="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/event_cream"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/event_gold_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="132dp">

            <com.apiculture.simulator.presentation.hive.ApiaryYardView
                android:id="@+id/yard_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:contentDescription="@null"
                android:focusable="false"
                android:importantForAccessibility="no" />

            <com.apiculture.simulator.presentation.common.AlertPulseDot
                android:id="@+id/apiary_alert_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_apiary_contract"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_apiary_npc_face"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_npc_portrait_ring"
                    android:contentDescription="@null"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Apisim.Circle"
                    app:strokeColor="@color/event_gold"
                    app:strokeWidth="2dp"
                    tools:src="@drawable/npc_face_00" />

                <TextView
                    android:id="@+id/tv_apiary_contract_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_contract_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/apiary_card_contract"
                    android:textColor="@color/event_gold_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/hs_apiary_flora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="6dp"
                android:maxWidth="200dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_apiary_flora_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="@string/dashboard_my_hives"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_colmena_prado" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_terrain_hex" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_apiary_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/event_ink"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Olivar norte" />

                <TextView
                    android:id="@+id/tv_apiary_climate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/event_gold_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Mediterráneo" />

                <TextView
                    android:id="@+id/tv_apiary_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/event_ink_muted"
                    android:textSize="13sp"
                    tools:text="3 colmenas" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apiary_open"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/apiary_card_open"
                android:textAllCaps="false"
                android:textColor="@color/event_ink"
                android:textStyle="bold"
                app:backgroundTint="@color/event_gold"
                app:cornerRadius="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apiary_harvest"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/apiary_card_harvest"
                    android:textAllCaps="false"
                    android:textColor="@color/event_ink"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/event_gold_stroke"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apiary_move"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/apiary_card_move"
                    android:textAllCaps="false"
                    android:textColor="@color/event_ink"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/event_gold_stroke"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apiary_map"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="@string/apiary_card_map"
                android:textAllCaps="false"
                android:textColor="@color/event_ink"
                app:cornerRadius="14dp"
                app:strokeColor="@color/event_gold_stroke"
                app:strokeWidth="1.5dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
