[Unit]
Description=API de Apiculture Simulator
After=network.target postgresql.service

[Service]
User=apiculture
WorkingDirectory=/opt/apiculture/apiculture-simulator/server
EnvironmentFile=/opt/apiculture/apiculture-simulator/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
