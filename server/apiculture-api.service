[Unit]
Description=API de Apiculture Simulator
After=network-online.target
Wants=network-online.target

[Service]
User=apiculture
WorkingDirectory=/opt/apiculture/apiculture-simulator/server
EnvironmentFile=/opt/apiculture/apiculture-simulator/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
