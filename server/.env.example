PGPASSWORD=cambia-esta-clave
API_TOKEN=cambia-este-token
# Recomendado: JSON de service account o GOOGLE_APPLICATION_CREDENTIALS.
# Si se define FIREBASE_PROJECT_ID, la API exige X-Firebase-Id-Token.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Solo para una importación administrativa; el reloj autoritativo debe dejarlo en 0.
ALLOW_OFFER_IMPORT=0
